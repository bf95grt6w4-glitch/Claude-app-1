# --- Server ---
PORT=8000
# Public URL of this server; must match the redirect URI registered with Spotify.
BASE_URL=http://127.0.0.1:8000

# --- Spotify Ad Shield (optional) ---
# Create an app at https://developer.spotify.com/dashboard and add
#   ${BASE_URL}/api/spotify/callback
# as a redirect URI.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Claude ad detection (optional) ---
# With a key set, podcast transcripts are classified by Claude for precise ad
# segments. Without one, a keyword heuristic is used instead.
ANTHROPIC_API_KEY=
